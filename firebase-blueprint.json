{
  "entities": {
    "LoginActivityLog": {
      "title": "LoginActivityLog",
      "description": "Historical record of each user login timestamp and session metadata",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Identifier of the user who logged in"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "userName": {
          "type": "string",
          "description": "Full name of the user"
        },
        "role": {
          "type": "string",
          "description": "Assigned institutional role of the user"
        },
        "loginTimestamp": {
          "type": "string",
          "description": "ISO timestamp of the login event"
        },
        "ip": {
          "type": "string",
          "description": "IP address of the client"
        },
        "browser": {
          "type": "string",
          "description": "Web browser used"
        },
        "device": {
          "type": "string",
          "description": "Client device operating system or type"
        },
        "action": {
          "type": "string",
          "description": "Specific authentication action performed"
        },
        "details": {
          "type": "string",
          "description": "Detailed log or context description"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the document was created"
        }
      },
      "required": ["userId", "userEmail", "loginTimestamp", "role"]
    },
    "UserActivitySummary": {
      "title": "UserActivitySummary",
      "description": "Aggregated latest presence and login state per user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Identifier of the user"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user"
        },
        "userName": {
          "type": "string",
          "description": "Full name of the user"
        },
        "role": {
          "type": "string",
          "description": "Assigned institutional role"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Most recent login ISO timestamp"
        },
        "lastActiveAt": {
          "type": "string",
          "description": "Most recent user activity ISO timestamp"
        },
        "lastIp": {
          "type": "string",
          "description": "Last known IP address"
        },
        "lastDevice": {
          "type": "string",
          "description": "Last known device"
        },
        "totalLogins": {
          "type": "number",
          "description": "Cumulative login count"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "userEmail", "lastLoginAt"]
    },
    "DeletionRequest": {
      "title": "DeletionRequest",
      "description": "Alert logs when non-owner users attempt record deletion or request deletion",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "recordType": { "type": "string" },
        "recordId": { "type": "string" },
        "recordTitle": { "type": "string" },
        "attemptedAt": { "type": "string" },
        "status": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["userId", "userEmail", "recordType", "recordId", "attemptedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with Firebase Auth identification and institutional roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "campusAccess": { "type": "string" },
        "permissionLevel": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Persistent user profile documents synchronized with Firebase Auth"
    },
    "/login_activity/{logId}": {
      "schema": "#/entities/LoginActivityLog",
      "description": "Collection of all user login events and timestamps"
    },
    "/user_activity_summaries/{userId}": {
      "schema": "#/entities/UserActivitySummary",
      "description": "Aggregated latest login and active presence summary per user"
    },
    "/deletion_requests/{requestId}": {
      "schema": "#/entities/DeletionRequest",
      "description": "Collection of recorded deletion attempts and requests for owner review"
    }
  }
}
